<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jasper.mapper.SysUserRoleTestMapper">

    <!-- 开启二级缓存 -->
    <cache/>

    <resultMap id="UserWithRoleResultMap" type="com.jasper.pojo.dto.SysUserRoleDTO">
        <id property="id" column="user_id"/>
        <result property="username" column="username"/>
        <result property="nickname" column="nickname"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <collection property="roles" ofType="com.jasper.pojo.entity.SysRole">
            <id property="id" column="role_id"/>
            <result property="roleName" column="role_name"/>
            <result property="roleKey" column="role_key"/>
        </collection>
    </resultMap>

    <!-- 关联查询映射 -->
    <select id="selectUserWithRoles" resultMap="UserWithRoleResultMap">
        SELECT
            u.id AS user_id,
            u.username,
            u.nickname,
            u.status,
            u.created_at,
            r.id AS role_id,
            r.role_name,
            r.role_key
        FROM sys_user u
                 LEFT JOIN sys_user_role ur ON u.id = ur.user_id
                 LEFT JOIN sys_role r ON ur.role_id = r.id
        WHERE u.id = #{userId}
    </select>

    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (id, username, password, nickname, status)
        VALUES (#{id}, #{username}, #{password}, #{nickname}, #{status})
        ON DUPLICATE KEY UPDATE username = #{username}, password = #{password}
    </insert>

</mapper>